{
  "name": "prompt-chain-dynamic-runtime",
  "version": "0.2.0",
  "description": "Prompt-chain JSON contracts executed by pi-dynamic-workflows with durable Git transactions and feedback closure",
  "type": "module",
  "private": false,
  "keywords": [
    "agent-workflow",
    "dag",
    "git-transaction",
    "pi",
    "pi-dynamic-workflows",
    "pi-package",
    "prompt-chain",
    "trip",
    "workflow-engine"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": {
    "name": "Taylor Bell",
    "url": "https://github.com/tayiorbeii"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tayiorbeii/prompt-chain-dynamic.git"
  },
  "homepage": "https://github.com/tayiorbeii/prompt-chain-dynamic#readme",
  "bugs": {
    "url": "https://github.com/tayiorbeii/prompt-chain-dynamic/issues"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "templates",
    "examples",
    "scripts",
    "tests",
    "tsconfig.json",
    "docs/ACCEPTANCE-GATES.md",
    "docs/ARCHITECTURE.md",
    "docs/FURTHER-OPPORTUNITIES.md",
    "docs/IMPLEMENTATION-STATUS.md",
    "docs/PROJECT-CREATION.md",
    "docs/SECURITY.md",
    "docs/CANARY.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10"
  },
  "scripts": {
    "test": "npm run check && node --experimental-strip-types --test tests/*.test.ts",
    "test:canary": "PROMPT_CHAIN_REAL_AGENT_CANARY=1 node --experimental-strip-types --test tests/canary.real-agent.test.ts",
    "validate:example": "node --experimental-strip-types bin/trip-validate.ts examples/example.trip.json",
    "compile:example": "node --experimental-strip-types bin/trip-compile.ts examples/example.plan.md --out examples/generated.trip.json --working-directory . --mode auto",
    "smoke": "bash scripts/smoke.sh",
    "check": "tsc --noEmit"
  },
  "bin": {
    "prompt-chain": "./bin/prompt-chain.ts",
    "trip-compile": "./bin/trip-compile.ts",
    "trip-validate": "./bin/trip-validate.ts",
    "trip-headless": "./bin/trip-headless.ts",
    "trip-loop": "./bin/trip-loop.ts",
    "trip-reaper": "./bin/trip-reaper.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.80.10",
    "@quintinshaw/pi-dynamic-workflows": "^3.3.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}
